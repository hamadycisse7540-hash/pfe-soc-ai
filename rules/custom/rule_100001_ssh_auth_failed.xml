<group name="local,syslog,sshd,">

  <!--
    RÈGLE — Echec authentification SSH (tous types)
    Trigger : if_sid=5710 (invalid user) + if_sid=5760 (auth failed)
    Match    : "Failed password" OU "Invalid user" OU "invalid user"
    Logique  : couvre les deux cas Wazuh :
               - 5760 = utilisateur valide, mot de passe incorrect
               - 5710 = utilisateur inexistant (enumeration de comptes)
               Pattern sur le message brut confirme le type d'echec
  -->
  <rule id="100001" level="5">
    <if_sid>5760</if_sid>
    <match>Failed password</match>
    <description>Custom: Echec SSH - pattern "Failed password" detecte dans log OpenSSH (T1110)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failed,pci_dss_10.2.4,gdpr_IV_35.7.d,</group>
  </rule>

  <rule id="100009" level="5">
    <if_sid>5710</if_sid>
    <match>Invalid user|invalid user</match>
    <description>Custom: Enumeration SSH - pattern "Invalid user" detecte, compte inexistant (T1110.003)</description>
    <mitre><id>T1110.003</id></mitre>
    <group>authentication_failed,pci_dss_10.2.4,gdpr_IV_35.7.d,</group>
  </rule>

</group>
