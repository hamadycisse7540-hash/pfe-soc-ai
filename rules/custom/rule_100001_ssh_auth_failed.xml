<group name="local,syslog,sshd,">

  <!--
    RÈGLE — Enumeration SSH (compte inexistant)
    Trigger : if_sid=5710 (sshd: Attempt to login using a non-existent user)
    Match    : pattern "Invalid user" dans le log sshd
    Logique  : 5710 est le parent natif Wazuh pour les comptes inexistants.
               Le match "Invalid user" confirme l'indicateur d'enumeration.
               Distinct du Brute Force : ici l'utilisateur n'existe pas.
  -->
  <rule id="100009" level="5">
    <if_sid>5710</if_sid>
    <match>Invalid user|invalid user</match>
    <description>Custom: Enumeration SSH - pattern "Invalid user" detecte, compte inexistant (T1110.003)</description>
    <mitre><id>T1110.003</id></mitre>
    <group>authentication_failed,pci_dss_10.2.4,gdpr_IV_35.7.d,</group>
  </rule>

</group>
