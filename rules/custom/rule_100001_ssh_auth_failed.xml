<group name="local,syslog,sshd,">

  <!--
    RÈGLE — Echec authentification SSH
    Trigger : if_sid=5760 (sshd: authentication failed)
    Match    : "Failed password" OU "Invalid user" dans le log sshd
    Logique  : détecte toute tentative d'authentification SSH échouée
               en cherchant les patterns caractéristiques dans les logs OpenSSH
  -->
  <rule id="100001" level="5">
    <if_sid>5760</if_sid>
    <match>Failed password|Invalid user</match>
    <description>Custom: Echec authentification SSH - patterns "Failed password" ou "Invalid user" detectes (T1110)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failed,pci_dss_10.2.4,gdpr_IV_35.7.d,</group>
  </rule>

</group>
