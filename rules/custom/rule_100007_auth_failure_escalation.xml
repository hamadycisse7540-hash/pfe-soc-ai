<group name="local,syslog,">
  <!-- Règle atomique : échecs PAM répétés -->
  <rule id="100007" level="10">
    <if_sid>5503</if_sid>
    <match>authentication failure|pam_unix</match>
    <description>Custom: Échecs authentification PAM multiples — possible tentative de brute force (T1110)</description>
    <mitre><id>T1110</id></mitre>
    <group>authentication_failures,pci_dss_10.2.4,</group>
  </rule>
</group>
