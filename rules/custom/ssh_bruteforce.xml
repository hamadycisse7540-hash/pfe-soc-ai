<group name="local,syslog,sshd,">

  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <description>sshd: authentication failed - custom rule.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100002" level="10">
    <if_sid>4100</if_sid>
    <match>IPTABLES-DROP</match>
    <srcip>!127.0.0.1</srcip>
    <description>Port scan detected via iptables DROP log</description>
    <group>scan_detection,reconnaissance,nmap_scan,</group>
  </rule>

  <rule id="100003" level="12" frequency="8" timeframe="120">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>Custom: SSH brute force attack detected</description>
    <group>brute_force,authentication_failures,</group>
  </rule>

  <rule id="100004" level="12">
    <if_sid>30100</if_sid>
    <match>sqlmap|UNION SELECT|OR 1=1|script</match>
    <description>Web attack detected in Apache logs</description>
    <group>web_attack,sql_injection,</group>
  </rule>

  <rule id="100005" level="10">
    <if_sid>30105</if_sid>
    <match>nikto|sqlmap|nmap</match>
    <description>Web scanner detected in Apache access log</description>
    <group>web_attack,scanner,</group>
  </rule>

  <rule id="100006" level="12">
    <if_sid>5402</if_sid>
    <description>Privilege escalation: sudo to ROOT executed</description>
    <group>privilege_escalation,sudo,</group>
  </rule>

  <rule id="100007" level="14">
    <if_sid>5503</if_sid>
    <description>Privilege escalation: authentication failure escalation</description>
    <group>privilege_escalation,</group>
  </rule>

  <rule id="100008" level="10">
    <if_sid>5901</if_sid>
    <description>Privilege escalation: new user/group created</description>
    <group>privilege_escalation,adduser,</group>
  </rule>

</group>
