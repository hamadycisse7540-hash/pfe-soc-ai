<group name="local,syslog,sshd,">

  <!--
    RÈGLE 1 — Echec SSH individuel
    Trigger : if_sid=5760 (sshd: authentication failed)
    Match    : pattern "Failed password" dans le log brut OpenSSH
    Logique  : chaque echec SSH contenant "Failed password" déclenche
               cette règle. Elle sert de compteur pour la règle 100003.
  -->
  <rule id="100010" level="6">
    <if_sid>5760</if_sid>
    <match>Failed password</match>
    <description>Custom: Echec SSH - pattern "Failed password" detecte (T1110.001)</description>
    <mitre><id>T1110.001</id></mitre>
    <group>authentication_failed,pci_dss_10.2.4,gdpr_IV_35.7.d,</group>
  </rule>

  <!--
    RÈGLE 2 — Brute Force SSH détecté
    Trigger : if_matched_sid=100010 (notre compteur d'echecs SSH)
    Logique  : corrélation temporelle — 8 echecs "Failed password"
               depuis la même IP en 120 secondes = comportement
               de brute force automatisé (Hydra, Medusa, Ncrack).
               same_source_ip garantit que c'est un seul attaquant.
  -->
  <rule id="100003" level="14" frequency="8" timeframe="120">
    <if_matched_sid>100010</if_matched_sid>
    <same_source_ip />
    <description>Custom: BRUTE FORCE SSH - 8 echecs "Failed password" en 120s depuis meme IP (T1110)</description>
    <mitre><id>T1110</id></mitre>
    <group>brute_force,authentication_failures,pci_dss_11.4,gdpr_IV_35.7.d,</group>
  </rule>

</group>
