<group name="local,syslog,adduser,">
  <!-- Règle atomique : création de compte utilisateur ou groupe -->
  <rule id="100008" level="10">
    <if_sid>5902</if_sid>
    <match>useradd|adduser|groupadd|new user|new group</match>
    <description>Custom: Création compte/groupe système — pattern creation compte detecte (T1136.001)</description>
    <mitre><id>T1136.001</id></mitre>
    <group>privilege_escalation,adduser,pci_dss_10.2.5,gdpr_IV_32.2,</group>
  </rule>
</group>
