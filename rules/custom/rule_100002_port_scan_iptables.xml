<group name="local,syslog,firewall,">
  <!-- Règle de corrélation : 20 paquets iptables DROP en 60s depuis la même IP -->
  <rule id="100002" level="10" frequency="20" timeframe="60">
    <if_matched_sid>4100</if_matched_sid>
    <match>IPTABLES-DROP</match>
    <same_source_ip />
    <srcip>!127.0.0.1</srcip>
    <description>Custom: Port Scan detecte — 20+ paquets iptables DROP en 60s depuis meme IP (T1046)</description>
    <mitre><id>T1046</id></mitre>
    <group>scan_detection,reconnaissance,pci_dss_11.4,</group>
  </rule>
</group>
