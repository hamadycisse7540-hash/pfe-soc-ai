<group name="local,syslog,firewall,">

  <!--
    RÈGLE — Port Scan détecté via iptables DROP
    Trigger : decoded_as=iptables-custom (notre decoder)
    Match    : pattern "IPTABLES-DROP" dans le log kernel
    Logique  : notre decoder extrait srcip du log iptables.
               La règle détecte chaque paquet DROP depuis une IP externe.
               Un scan Nmap génère des dizaines de DROP en quelques secondes.
  -->
  <rule id="100002" level="10">
    <decoded_as>iptables-custom</decoded_as>
    <match>IPTABLES-DROP</match>
    <srcip>!127.0.0.1</srcip>
    <description>Custom: Paquet DROP iptables detecte - indicateur scan reseau (T1046)</description>
    <mitre><id>T1046</id></mitre>
    <group>scan_detection,reconnaissance,pci_dss_11.4,</group>
  </rule>

</group>
