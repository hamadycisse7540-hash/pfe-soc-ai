# Copie ce fichier en .env et remplis les vraies valeurs.
# Le .env est ignoré par git (voir .gitignore).

# Clé API Anthropic — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-REMPLACE_MOI

# Configuration email — rapports SOC (SMTP Gmail)
# EMAIL_PASS = mot de passe d'application Gmail (16 caractères, PAS le mot de passe du compte)
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_FROM=ton.email@example.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_TO=ton.email@example.com
